<?xml version="1.0"?>

<robot
  xmlns:xacro="http://www.ros.org/wiki/xacro"
  name="machine_dog">

  <!-- ========================= -->
  <!-- Robot base coordinate     -->
  <!-- ========================= -->

  <link name="base_link"/>


  <!-- ========================= -->
  <!-- Main body                 -->
  <!-- ========================= -->

  <link name="body_link">

    <visual>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.50 0.24 0.12"/>
      </geometry>

      <material name="body_blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>

    </visual>


    <collision>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.50 0.24 0.12"/>
      </geometry>

    </collision>


    <inertial>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <mass value="8.0"/>

      <inertia
        ixx="0.048"
        ixy="0.0"
        ixz="0.0"
        iyy="0.1763"
        iyz="0.0"
        izz="0.2051"/>

    </inertial>

  </link>


  <!-- ========================= -->
  <!-- base_link -> body_link    -->
  <!-- ========================= -->

  <joint
    name="base_to_body"
    type="fixed">

    <parent link="base_link"/>

    <child link="body_link"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>

  </joint>

</robot>